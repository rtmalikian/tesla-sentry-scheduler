# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored — your secrets never leave your machine.

# --- Tesla Fleet API credentials ---------------------------------------
# Register a developer application at https://developer.tesla.com
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
# Fleet API region: na (North America), eu (Europe), cn (China)
TESLA_REGION=na
TESLA_REDIRECT_URI=http://localhost:8080/callback
# Where OAuth tokens are stored locally (file is created with mode 600)
TESLA_TOKEN_FILE=~/.tcc/tokens.json

# --- Your vehicles -------------------------------------------------------
# Format: name=VIN, one entry per car, comma-separated.
TCC_VEHICLES=Daily=5YJ3E1EA0KF000001,Second=7SAYGDEE5PF000002

# --- Sentry schedule -----------------------------------------------------
# Sentry is armed inside this window, disarmed outside it.
# Overnight example: 22:00-06:00. Daytime example (work hours): 09:00-17:00.
TCC_SENTRY_ON=22:00
TCC_SENTRY_OFF=06:00
# Days the schedule applies to (mon,tue,wed,thu,fri,sat,sun)
TCC_SENTRY_DAYS=mon,tue,wed,thu,fri,sat,sun

# --- Runtime ---------------------------------------------------------------
TCC_STATE_FILE=~/.tcc/sentry_scheduler_state.json
# Daemon poll interval in seconds (only used by `tcc-sentry run`).
# Cheapest option: run `tcc-sentry run --once` via cron at your
# TCC_SENTRY_ON and TCC_SENTRY_OFF times instead of the daemon.
TCC_POLL_INTERVAL_SECONDS=900
# Dry run: log what WOULD happen without sending any commands.
TCC_DRY_RUN=false
